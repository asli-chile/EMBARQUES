---
import { AppShell } from "@/components/layout";
import { stripBasePathname, withBase } from "@/lib/basePath";
import "@/styles/globals.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "EMBARQUES - Logística y Comercio Exterior", description = "Logística y Comercio Exterior" } = Astro.props;
const pathname = stripBasePathname(Astro.url.pathname);
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={withBase("/logoasli.png")} />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script
      type="module"
      src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"
    ></script>
    <style is:global>
      vercel-live-feedback, #vercel-live-feedback, .__vercel_live_token,
      [data-vercel-toolbar], vercel-toolbar { display: none !important; }
    </style>
  </head>
  <body class="h-screen overflow-hidden font-sans antialiased" style="--font-open-sans: 'Open Sans', system-ui, sans-serif">
    <!--
      Loader pre-hidratación: shell claro (mismo fondo que módulos).
      En navegaciones siguientes de la sesión se oculta al instante (sin pestañeo navy).
    -->
    <div
      id="app-shell-loading"
      class="fixed inset-0 z-[2147483647] flex flex-col overflow-hidden bg-[#D9E3F2]"
      aria-busy="true"
      aria-live="polite"
    >
      <div class="h-14 shrink-0 bg-neutral-700/95 border-b border-white/10" aria-hidden="true"></div>
      <div class="flex-1 min-h-0 flex flex-col">
        <div class="shrink-0 bg-gradient-to-br from-brand-blue via-[#0d1c42] to-brand-dark-teal px-4 sm:px-6 pt-5 pb-4">
          <div class="flex items-center gap-3.5">
            <div class="h-12 w-12 rounded-lg bg-white/15 border border-white/20"></div>
            <div class="min-w-0 flex-1 space-y-2">
              <div class="h-7 w-44 max-w-[55%] rounded-md bg-white/20"></div>
              <div class="h-4 w-28 max-w-[40%] rounded-md bg-white/12"></div>
            </div>
          </div>
        </div>
        <div class="shrink-0 border-b border-brand-blue/15 bg-[#E8F0FA]/95 px-3 sm:px-4 py-3">
          <div class="flex flex-wrap gap-2">
            <div class="h-10 w-24 rounded-lg bg-brand-blue/10"></div>
            <div class="h-10 w-28 rounded-lg bg-brand-blue/10"></div>
            <div class="h-10 w-20 rounded-lg bg-brand-blue/10"></div>
          </div>
        </div>
        <div class="min-h-0 flex-1 p-3 sm:p-4">
          <div class="h-full min-h-[200px] rounded-xl border border-brand-blue/15 bg-white/80 shadow-sm"></div>
        </div>
      </div>
      <p
        id="app-shell-loading-hint"
        class="absolute bottom-4 left-1/2 z-10 hidden max-w-sm -translate-x-1/2 px-4 text-center text-xs leading-snug text-brand-blue/50"
        style="display: none"
      >
        Si esto no desaparece, el JavaScript falló en este dispositivo. En Chrome (Android): USB → Depurar en el PC
        (chrome://inspect). Revisa la consola y la pestaña Red por URLs en rojo.
      </p>
    </div>
    <script is:inline>
      (function () {
        try {
          if (sessionStorage.getItem("erp-shell-ready") === "1") {
            var el = document.getElementById("app-shell-loading");
            if (el) el.style.display = "none";
          }
        } catch (_) {}
      })();
    </script>
    <AppShell client:load pathname={pathname}>
      <slot />
    </AppShell>
    <script is:inline>
      (function () {
        var hint = document.getElementById("app-shell-loading-hint");
        var t = setTimeout(function () {
          if (hint) {
            hint.classList.remove("hidden");
            hint.style.display = "block";
          }
        }, 12000);
        function removeLoader() {
          clearTimeout(t);
          try {
            sessionStorage.setItem("erp-shell-ready", "1");
          } catch (_) {}
          var el = document.getElementById("app-shell-loading");
          if (el) el.remove();
        }
        function bind() {
          var island = document.querySelector("astro-island");
          if (!island) {
            requestAnimationFrame(bind);
            return;
          }
          island.addEventListener("astro:hydrate", removeLoader);
        }
        bind();
      })();
    </script>
  </body>
</html>
