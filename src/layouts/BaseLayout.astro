---
import { AppShell } from "@/components/layout";
import FaviconLinks from "@/components/layout/FaviconLinks.astro";
import { stripBasePathname, withBase } from "@/lib/basePath";
import { getRouteChrome, hasSkeletonBones, routeChromeBg } from "@/lib/ui/routeChrome";
import "@/styles/globals.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "EMBARQUES - Logística y Comercio Exterior", description = "Logística y Comercio Exterior" } = Astro.props;
const pathname = stripBasePathname(Astro.url.pathname);
const chrome = getRouteChrome(pathname);
const showBones = hasSkeletonBones(chrome);
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <FaviconLinks />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600;1,700&display=swap"
      rel="stylesheet"
      media="(min-width: 768px)"
    />
    <title>{title}</title>
    <script src={withBase("/erp-busy.js")}></script>
    <style is:global>
      vercel-live-feedback, #vercel-live-feedback, .__vercel_live_token,
      [data-vercel-toolbar], vercel-toolbar { display: none !important; }
    </style>
  </head>
  <body class="h-screen max-w-full overflow-hidden font-sans antialiased" style="--font-open-sans: 'Open Sans', system-ui, sans-serif">
    <!--
      Loader pre-hidratación. Coincide con AppChromeFrame: rail 64px + fondo de ruta.
      El área de contenido sigue a ModuleSoftFallback (huesos solo en módulos).
    -->
    <div
      id="app-shell-loading"
      class="fixed inset-0 z-[2147483647] flex overflow-hidden bg-[#050914] transition-opacity duration-fast ease-standard"
      aria-busy="true"
      aria-live="polite"
    >
      <div
        class="z-40 h-full w-[64px] shrink-0 border-r border-black/20 bg-[#0B1A3D] pt-[env(safe-area-inset-top)]"
        aria-hidden="true"
      ></div>
      <div class:list={["flex min-h-0 min-w-0 flex-1 flex-col", routeChromeBg[chrome]]}>
        {showBones && (
          <>
            <div class="shrink-0 bg-gradient-to-br from-brand-blue via-[#0d1c42] to-brand-dark-teal px-4 sm:px-6 pt-5 pb-4">
              <div class="flex items-center gap-3.5">
                <div class="motion-skeleton motion-skeleton-on-dark h-12 w-12 shrink-0 rounded-lg"></div>
                <div class="min-w-0 flex-1 space-y-2">
                  <div class="motion-skeleton motion-skeleton-on-dark h-7 w-40 max-w-[55%] rounded-md"></div>
                  <div class="motion-skeleton motion-skeleton-on-dark h-4 w-28 max-w-[40%] rounded-md"></div>
                </div>
              </div>
            </div>
            <div class="shrink-0 border-b border-brand-blue/15 bg-[#E8F0FA]/95 px-3 sm:px-4 py-3">
              <div class="flex flex-wrap gap-2">
                <div class="motion-skeleton h-10 w-24 rounded-lg"></div>
                <div class="motion-skeleton h-10 w-28 rounded-lg"></div>
                <div class="motion-skeleton h-10 w-20 rounded-lg"></div>
              </div>
            </div>
            <div class="min-h-0 flex-1 p-3 sm:p-4">
              <div class="motion-skeleton motion-skeleton-surface h-full min-h-[200px] rounded-xl border border-brand-blue/15 shadow-sm"></div>
            </div>
          </>
        )}
      </div>
      <p
        id="app-shell-loading-hint"
        class="absolute bottom-4 left-1/2 z-10 hidden max-w-sm -translate-x-1/2 px-4 text-center text-xs leading-snug text-white/45"
        style="display: none"
      >
        Si esto no desaparece, el JavaScript falló en este dispositivo. En Chrome (Android): USB → Depurar en el PC
        (chrome://inspect). Revisa la consola y la pestaña Red por URLs en rojo.
      </p>
    </div>
    <AppShell client:load pathname={pathname}>
      <slot />
    </AppShell>
    <script is:inline>
      (function () {
        var hint = document.getElementById("app-shell-loading-hint");
        var t = setTimeout(function () {
          if (hint) {
            hint.classList.remove("hidden");
            hint.style.display = "block";
          }
        }, 12000);
        function removeLoader() {
          clearTimeout(t);
          var el = document.getElementById("app-shell-loading");
          if (el) {
            el.style.opacity = "0";
            el.style.pointerEvents = "none";
            setTimeout(function () {
              el.remove();
            }, 160);
          }
          if (window.erpBusy) window.erpBusy.hide();
        }
        function bind() {
          var island = document.querySelector("astro-island");
          if (!island) {
            requestAnimationFrame(bind);
            return;
          }
          island.addEventListener("astro:hydrate", removeLoader);
        }
        bind();
      })();
    </script>
  </body>
</html>
