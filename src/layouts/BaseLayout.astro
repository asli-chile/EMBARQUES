---
import { AppShell } from "@/components/layout";
import FaviconLinks from "@/components/layout/FaviconLinks.astro";
import { stripBasePathname, withBase } from "@/lib/basePath";
import { getRouteChrome } from "@/lib/ui/routeChrome";
import { ModuleSoftFallback } from "@/components/ui/ModuleSoftFallback";
import "@/styles/globals.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "EMBARQUES - Logística y Comercio Exterior", description = "Logística y Comercio Exterior" } = Astro.props;
const pathname = stripBasePathname(Astro.url.pathname);
const chrome = getRouteChrome(pathname);
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <FaviconLinks />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600;1,700&display=swap"
      rel="stylesheet"
      media="(min-width: 768px)"
    />
    <title>{title}</title>
    <!--
      Tema neón antes del primer pintado. La preferencia vive en localStorage
      (src/lib/ui/neonTheme.ts); sin esto, la pantalla de carga no sabe si es
      oscura o clara hasta que hidrata React, y quien usa el tema claro ve un
      destello del otro.
    -->
    <script is:inline>
      (function () {
        var t = "dark";
        try {
          var v = localStorage.getItem("erp-neon-theme") || localStorage.getItem("informativos-studio-theme");
          if (v === "light" || v === "dark") t = v;
        } catch (e) {}
        document.documentElement.dataset.erpNeon = t;
      })();
    </script>
    <script src={withBase("/erp-busy.js")}></script>
    <style is:global>
      vercel-live-feedback, #vercel-live-feedback, .__vercel_live_token,
      [data-vercel-toolbar], vercel-toolbar { display: none !important; }
    </style>
  </head>
  <body class="h-screen max-w-full overflow-hidden font-sans antialiased" style="--font-open-sans: 'Open Sans', system-ui, sans-serif">
    <!--
      Loader pre-hidratación. Coincide con AppChromeFrame: rail 64px + fondo de ruta.
      El área de contenido ES ModuleSoftFallback, renderizado en el servidor sin
      JavaScript: una sola pieza para la carga previa y la de Suspense.
    -->
    <div
      id="app-shell-loading"
      class="fixed inset-0 z-[2147483647] flex overflow-hidden bg-[#050914] transition-opacity duration-fast ease-standard"
      aria-busy="true"
      aria-live="polite"
    >
      <div
        class="z-40 hidden h-full w-[64px] shrink-0 border-r border-black/20 bg-[#0B1A3D] pt-[env(safe-area-inset-top)] md:block"
        aria-hidden="true"
      ></div>
      <ModuleSoftFallback chrome={chrome} />
      <p
        id="app-shell-loading-hint"
        class="absolute bottom-4 left-1/2 z-10 hidden max-w-sm -translate-x-1/2 px-4 text-center text-xs leading-snug text-white/45"
        style="display: none"
      >
        Si esto no desaparece, el JavaScript falló en este dispositivo. En Chrome (Android): USB → Depurar en el PC
        (chrome://inspect). Revisa la consola y la pestaña Red por URLs en rojo.
      </p>
    </div>
    <AppShell client:load pathname={pathname}>
      <slot />
    </AppShell>
    <script is:inline>
      (function () {
        var hint = document.getElementById("app-shell-loading-hint");
        var t = setTimeout(function () {
          if (hint) {
            hint.classList.remove("hidden");
            hint.style.display = "block";
          }
        }, 12000);
        function removeLoader() {
          clearTimeout(t);
          var el = document.getElementById("app-shell-loading");
          if (el) {
            el.style.opacity = "0";
            el.style.pointerEvents = "none";
            setTimeout(function () {
              el.remove();
            }, 160);
          }
          if (window.erpBusy) window.erpBusy.hide();
        }
        function bind() {
          var island = document.querySelector("astro-island");
          if (!island) {
            requestAnimationFrame(bind);
            return;
          }
          island.addEventListener("astro:hydrate", removeLoader);
        }
        bind();
      })();
    </script>
  </body>
</html>
