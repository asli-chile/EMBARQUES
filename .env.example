# Copiar a .env / .env.local y rellenar con valores reales (nunca commitear secretos).
PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Edge Function access-request (Supabase secrets): ACCESS_REQUEST_NOTIFY_EMAIL=rodrigo.caceres@asli.cl
# Opcional: migración masiva operaciones → POST /api/admin/import-operaciones-migracion
# MIGRATION_IMPORT_SECRET=
# PUBLIC_GMAIL_DRAFT_SCRIPT_URL=
# Stacking PIL (web /stacking/pil). El sync corre en la Edge Function stacking-pil-sync
# con GOOGLE_SERVICE_ACCOUNT (mismo que send-email) + scope gmail.readonly.
# STACKING_SYNC_TOKEN=
# STACKING_PIL_MAILBOX=rodrigo.caceres@asli.cl
# PUBLIC_SITE_URL=https://tu-dominio.cl
# Obligatorio en producción para que logos/íconos del HTML de informativos
# carguen en Gmail (URLs absolutas). En local usa el origin del navegador.
# Ejemplo con ERP en subpath: PUBLIC_SITE_URL=https://asli.cl
# MYSHIPTRACKING_API_KEY=
# DOCLING_SERVICE_URL=http://localhost:8000
# DOCLING_API_KEY=
