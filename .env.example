# Copiar a .env / .env.local y rellenar con valores reales (nunca commitear secretos).
PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Edge Function access-request (Supabase secrets): ACCESS_REQUEST_NOTIFY_EMAIL=rodrigo.caceres@asli.cl
# Opcional: migración masiva operaciones → POST /api/admin/import-operaciones-migracion
# MIGRATION_IMPORT_SECRET=
# PUBLIC_GMAIL_DRAFT_SCRIPT_URL=
# Stacking PIL (web /stacking/pil). El sync corre en la Edge Function stacking-pil-sync
# con GOOGLE_SERVICE_ACCOUNT (mismo que send-email) + scope gmail.readonly.
# STACKING_SYNC_TOKEN=  # obligatorio en web2 para /api/stacking/sync
# STACKING_PIL_MAILBOX=rodrigo.caceres@asli.cl
# PUBLIC_SITE_URL=https://tu-dominio.cl
# Obligatorio en producción para que logos/íconos del HTML de informativos
# carguen en Gmail (URLs absolutas). En local usa el origin del navegador.
# Ejemplo con ERP en subpath: PUBLIC_SITE_URL=https://asli.cl
# MYSHIPTRACKING_API_KEY=

# Data Docked: proveedor AIS de NaviTrack (/navitrack).
# Solo servidor, nunca con prefijo PUBLIC_. Se obtiene en datadocked.com,
# en el panel de perfil, tras verificar la cuenta.
# DATADOCKED_API_KEY=

# Control de gasto de NaviTrack (cada consulta al proveedor = 1 crédito).
# TTL: minutos que una posición guardada se considera vigente. 360 = 4 llamadas/día por nave.
# Un viaje de 30 días con una nave cuesta ~120 créditos con este valor.
# NAVITRACK_AIS_TTL_MIN=360
# Tope duro de llamadas por día, sumando todas las naves. Red de seguridad.
# NAVITRACK_AIS_MAX_DIA=10
# Horas que el historial de escalas se considera vigente. Es la consulta más cara
# del proveedor (su documentación dice 1 en una página y 5 en otra: se asume 5).
# NAVITRACK_ESCALAS_TTL_H=24

# Chequeo diario de desvíos (cron de Vercel, 12:00 UTC = 08:00 en Chile).
# Secreto compartido: mínimo 16 caracteres. El mismo valor debe existir como
# NAVITRACK_CRON_SECRET en los secrets de la Edge Function send-email.
# NAVITRACK_CRON_SECRET=
# Casilla que recibe las alertas de cambio de ruta.
# NAVITRACK_ALERTAS_EMAIL=rodrigo.caceres@asli.cl
# Naves como máximo por corrida (1 crédito cada una).
# NAVITRACK_CHEQUEO_MAX=25

# Hora local que muestra el panel de Rastreo para la revisión diaria. Es solo
# texto: el horario real lo fija "crons" en vercel.json, que va en UTC.
# NAVITRACK_CHEQUEO_HORA=07:00
# DOCLING_SERVICE_URL=http://localhost:8000
# DOCLING_API_KEY=
