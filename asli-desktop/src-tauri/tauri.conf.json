{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ASLI Embarques",
  "version": "0.1.13",
  "identifier": "cl.asli.embarques",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:4321/embarques"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ASLI Embarques",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "url": "https://www.asli.cl/embarques/"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "category": "Business",
    "shortDescription": "ASLI Embarques — shell de escritorio",
    "longDescription": "Acceso de escritorio al ERP ASLI Embarques. La aplicación web se actualiza con cada deploy; este instalador solo actualiza el contenedor.",
    "copyright": "ASLI Logística y Comercio Exterior",
    "publisher": "ASLI",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwOTkwMUZBMzFEN0M0QTQKUldTa3hOY3grZ0daVURaMFArZy85ck9jQm1Rc3BkMFZNQm5NVmVKS3FlaEQvWFJtaU5MSUExejgK",
      "endpoints": [
        "https://github.com/asli-chile/EMBARQUES/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}
