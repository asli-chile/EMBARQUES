{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window + IPC from the live ERP origin (native Windows chrome).",
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://www.asli.cl/*",
      "https://asli.cl/*",
      "http://localhost:4321/*",
      "http://127.0.0.1:4321/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "opener:default",
    "updater:default",
    "process:default",
    "dialog:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
