{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "astro build",
  "framework": "astro",
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/embarques/favicon.ico"
    }
  ],
  "crons": [
    {
      "path": "/api/navitrack/chequeo-diario",
      "schedule": "0 12 * * *"
    }
  ]
}
